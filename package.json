{
  "name": "fac-transcript",
  "version": "0.4.0",
  "private": true,
  "description": "Application de transcription de cours magistraux",
  "author": "FAC Transcript",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test": "node --test --experimental-strip-types tests/regressions.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "package:win": "npm run build && electron-builder --win nsis",
    "prepare:whisper:mac": "bash scripts/prepare-whisper-macos-arm64.sh",
    "package:mac": "npm run prepare:whisper:mac && npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@electron-toolkit/utils": "latest",
    "@fontsource-variable/geist": "latest",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "better-sqlite3": "12.11.1",
    "electron-updater": "^6.8.9",
    "extract-zip": "latest",
    "ffmpeg-static": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "39.8.10",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "typescript": "latest",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "fr.factranscript.app",
    "productName": "FAC Transcript",
    "artifactName": "FAC-Transcript-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Goune1",
      "repo": "wispr"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "vendor/whisper.cpp/darwin-arm64",
        "to": "vendor/whisper.cpp/darwin-arm64",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FAC Transcript utilise le microphone pour enregistrer vos cours."
      }
    }
  }
}
